# 复制本文件为 .env 并填入你自己的配置（.env 已被 .gitignore 排除，不会入库）

# ---- LLM 聊天模型（OpenAI 兼容接口）----
API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BASE_URL=https://openrouter.ai/api/v1
MODEL=inclusionai/ling-3.0-flash-sante:free

# ---- Embedding 模型（可选，RAG 用）----
# 不配则 step24 自动降级为本地哈希向量（离线可跑，精度略降）
# 示例（SiliconFlow，有免费档）：EMBEDD_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDD_MODEL=BAAI/bge-m3
# EMBEDD_API_KEY=sk-xxxx

# ---- 本地代理（可选；Docker 里通常留空）----
HTTP_PROXY=http://127.0.0.1:10808
